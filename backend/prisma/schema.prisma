// Production-grade Optix Backend Enterprise Schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  STAFF
  SUPER_ADMIN
}

enum PricingType {
  FIXED
  WEIGHT
  OPEN
}

enum OrderStatus {
  PAID
  PENDING
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  SYNCING
  FAILED
  SUCCESS
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// --- CORE TABLES ---

model Business {
  id                    String   @id @default(uuid())
  name                  String
  email                 String?
  phone                 String?
  address               String?
  country               String   @default("India")
  setupCompleted        Boolean  @default(false)
  tokenCounter          Int      @default(0)
  lastTokenResetDateTime DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  isDeleted             Boolean  @default(false)
  deletedAt         DateTime?
  deletedBy         String?

  // Multi-branch
  branches          Branch[]
  settings          BusinessSettings?
  receiptSettings   ReceiptSettings?
  printerSettings   PrinterSettings[]
  paymentQrs        PaymentQr[]
  users             User[]
  staff             Staff[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  customers         Customer[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  devices           Device[]
  syncQueues        SyncQueue[]
  featureFlags      FeatureFlag[]
  apiKeys           ApiKey[]
  notifications     Notification[]
  dailySummaries    DailySalesSummary[]
  transactions      PaymentTransaction[]
  supportTickets    SupportTicket[]
}


model Branch {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  address     String?
  phone       String?
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  billingSessions BillingSession[]
}

model BusinessSettings {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id])
  currency              String   @default("INR")
  openingTime           String   @default("09:00")
  closingTime           String   @default("22:00")
  timezone              String   @default("Asia/Riyadh")
  taxEnabled            Boolean  @default(false)
  taxPercentage         Decimal  @default(0.0) @db.Decimal(10, 2)
  lastResetBusinessDate String?
}

model ReceiptSettings {
  id                String   @id @default(uuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id])
  showLogo          Boolean  @default(false)
  logoUrl           String?
  headerMessage     String?
  footerMessage     String   @default("Thank You! Visit Again")
  showBusinessName  Boolean  @default(true)
  showAddress       Boolean  @default(true)
  showPhone         Boolean  @default(true)
  showGst           Boolean  @default(false)
  showDateTime      Boolean  @default(true)
  showOrderNumber   Boolean  @default(true)
  showCashierName   Boolean  @default(true)
  showDiscounts     Boolean  @default(true)
  showTaxes         Boolean  @default(false)
  taxPercentage     Decimal  @default(0.0) @db.Decimal(10, 2)
  qrEnabled         Boolean  @default(false)
  showVisitAgain    Boolean  @default(true)
}

model PrinterSettings {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id])
  deviceName        String?
  deviceAddress     String?
  connectionType    String   @default("Bluetooth") // Bluetooth, USB, Network
  paperWidth        Int      @default(58) // 58 or 80
  autoConnect       Boolean  @default(true)
  copies            Int      @default(1)
  isDefault         Boolean  @default(true)
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String   // Argon2 Hashed
  role          UserRole @default(OWNER)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  devices       Device[]
}

model Staff {
  id                  String    @id @default(uuid())
  name                String
  username            String    @unique
  password            String    // Argon2 Hashed
  role                UserRole  @default(STAFF)
  businessId          String
  business            Business  @relation(fields: [businessId], references: [id])

  permissions         Permission[]
  billingSessions     BillingSession[]
  activityLogs        StaffActivityLog[]
  sessions            StaffSession[]

  isDisabled          Boolean   @default(false)
  phone               String?
  email               String?
  failedLoginCount    Int       @default(0)
  lastFailedLoginAt   DateTime?
  lastActivityAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Permission {
  id          String @id @default(uuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id])
  action      String // e.g., "DELETE_BILL", "VIEW_REPORTS", "MANAGE_INVENTORY"
}

model Device {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id])
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  deviceName       String
  deviceModel      String?
  androidVersion   String?
  appVersion       String?  @default("1.0.0")
  batteryLevel     Int?     @default(100)
  ipAddress        String?
  currentScreen    String?  @default("Main")
  connectionStatus String   @default("ONLINE") // ONLINE, OFFLINE
  lastSeen         DateTime @default(now())
  pushToken        String?

  refreshTokens   RefreshToken[]
  billingSessions BillingSession[]
}


model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  deviceId    String?
  device      Device?  @relation(fields: [deviceId], references: [id])
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
}

model BillingSession {
  id          String    @id @default(uuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id])
  staffId     String?
  staff       Staff?    @relation(fields: [staffId], references: [id])
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @default(0.0) @db.Decimal(12, 2)
  closingCash Decimal?  @db.Decimal(12, 2)
  status      String    @default("OPEN") // OPEN, CLOSED
}

// --- CRM & EXPENSES ---

model Customer {
  id          String                @id @default(uuid())
  businessId  String
  business    Business              @relation(fields: [businessId], references: [id])
  name        String
  phone       String?
  email       String?
  totalDebt   Decimal               @default(0.0) @db.Decimal(12, 2)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  isDeleted   Boolean               @default(false)

  transactions CustomerTransaction[]
  addresses    CustomerAddress[]
  orders       Order[]
}

model CustomerTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  type        String   // DEBIT, CREDIT
  note        String?
  createdAt   DateTime @default(now())
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  street      String
  city        String?
  state       String?
  pincode     String?
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  name        String
  expenses    Expense[]
}

model Expense {
  id          String          @id @default(uuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id])
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  note        String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
}

// --- SYNCABLE ENTITIES ---

model Category {
  id          String    @id @default(uuid())
  name        String
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  sortOrder   Int       @default(0)

  version     Int       @default(1)
  isDeleted   Boolean   @default(false)
  lastModified DateTime  @updatedAt @default(now())

  products    Product[]
}

model Product {
  id           String      @id @default(uuid())
  name         String
  description  String?
  barcode      String?
  sku          String?
  price        Decimal     @db.Decimal(12, 2)
  pricingType  PricingType @default(FIXED)
  unit         String      @default("Piece")

  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id])

  isOutOfStock Boolean     @default(false)
  imageUrl     String?

  version      Int         @default(1)
  isDeleted    Boolean     @default(false)
  lastModified DateTime    @updatedAt @default(now())

  inventory    Inventory?
  movements    StockMovement[]
}

model Inventory {
  id           String   @id @default(uuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @default(0.0) @db.Decimal(12, 3)
  minStockLevel Decimal @default(0.0) @db.Decimal(12, 3)
  lastModified DateTime @updatedAt
}

model StockMovement {
  id           String            @id @default(uuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  referenceId  String?           // e.g., OrderId
  note         String?
  createdAt    DateTime          @default(now())
}

model Order {
  id             String        @id @default(uuid())
  tokenNumber    String
  invoiceNumber  String
  status         OrderStatus   @default(PAID)

  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)

  paymentMethod  PaymentMethod @default(CASH)
  cashierName    String
  customerName   String?

  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])

  businessId     String
  business       Business      @relation(fields: [businessId], references: [id])

  items          OrderItem[]
  createdAt      DateTime      @default(now())
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  productName String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int?
  weight      Decimal? @db.Decimal(12, 3)
  unit        String?
}

// --- PLANS & SUBSCRIPTIONS ---

model Plan {
  id            String         @id @default(uuid())
  name          String         // Free, Starter, Professional, Enterprise
  price         Decimal        @db.Decimal(12, 2)
  billingPeriod String         @default("MONTHLY") // MONTHLY, YEARLY
  features      Json
  createdAt     DateTime       @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id              String             @id @default(uuid())
  businessId      String             @unique
  business        Business           @relation(fields: [businessId], references: [id])
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(TRIAL)
  country         String             @default("India")
  currency        String             @default("INR")
  billingCycle    BillingCycle       @default(MONTHLY)
  billsUsed       Int                @default(0)
  productsUsed    Int                @default(0)
  activationCode  String?
  expiryDate      DateTime
  renewalDate     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  transactions    PaymentTransaction[]
}

model PaymentTransaction {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id])

  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])

  planId            String
  billingCycle      BillingCycle
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("INR")
  country           String   @default("India")

  status            String   // PENDING, CAPTURED, FAILED, REFUNDED, CANCELLED

  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?

  failureReason     String?
  gatewayMetadata   Json?

  createdAt         DateTime @default(now())
  capturedAt        DateTime?
}

model ActivationCode {
  id                String    @id @default(uuid())
  code              String    @unique
  planId            String    // STARTER, GROWTH
  billingCycle      BillingCycle @default(MONTHLY)
  maxUses           Int       @default(1)   // -1 = unlimited
  usedCount         Int       @default(0)
  countryRestriction String?  // null = any country, else 'India', 'Saudi Arabia'
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


model PaymentQr {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String   @default("UPI QR")
  upiId       String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- SYSTEM & QUEUES ---

model SyncQueue {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id])
  entity      String        // PRODUCT, CATEGORY, ORDER, etc.
  entityId    String
  operation   SyncOperation
  status      SyncStatus    @default(PENDING)
  retryCount  Int           @default(0)
  createdAt   DateTime      @default(now())
}

model FeatureFlag {
  id            String    @id @default(uuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureKey    String    // e.g. "BILLING", "PRODUCTS", "AI_MENU_IMPORT"
  status        String    @default("ON") // ON, OFF, BETA, MAINTENANCE
  level         String    @default("GLOBAL") // GLOBAL, COUNTRY, PLAN, BUSINESS
  target        String?   // null for GLOBAL, or country name, plan name, or businessId
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([featureKey, level, target])
}

model GlobalConfig {
  id                     String   @id @default("GLOBAL")
  maintenanceMode        Boolean  @default(false)
  maintenanceMessage     String   @default("System under maintenance. Please try again shortly.")
  minSupportedAppVersion String   @default("1.0.0")
  latestStableVersion    String   @default("1.0.0")
  forceUpdate            Boolean  @default(false)
  apiEndpoint            String   @default("https://api.optixapp.in")
  webSocketEndpoint      String   @default("https://api.optixapp.in/events")
  supportEmail           String   @default("support@optixapp.in")
  supportPhone           String   @default("+919876543210")
  supportWhatsApp        String   @default("+919876543210")
  updatedAt              DateTime @updatedAt
}


model ApiKey {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  hashedKey   String
  permissions String[]
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  title       String
  message     String
  type        String   @default("INFO")
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL
  read        Boolean  @default(false)
  isArchived  Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
}

model DailySalesSummary {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  date        DateTime
  totalSales  Decimal  @db.Decimal(12, 2)
  totalOrders Int
  totalTax    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@unique([businessId, date])
}

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  userId      String?
  action      String   // e.g. "UPDATE_PRICE", "DELETE_BILL"
  entity      String   // e.g. "PRODUCT", "ORDER"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  endpoint    String?
  requestId   String?
  createdAt   DateTime @default(now())
}

model StaffActivityLog {
  id          String   @id @default(uuid())
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  businessId  String
  action      String   // e.g. "LOGIN", "CREATE_ORDER", "DELETE_ORDER", "CHANGE_PRICE"
  entityType  String?  // e.g. "ORDER", "PRODUCT"
  entityId    String?
  metadata    Json?
  deviceId    String?
  ipAddress   String?
  isSuspicious Boolean @default(false)
  severity    String   @default("NORMAL") // NORMAL, WARNING, CRITICAL
  createdAt   DateTime @default(now())
}

model StaffSession {
  id          String    @id @default(uuid())
  staffId     String
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  businessId  String
  deviceId    String?
  deviceName  String?
  loginAt     DateTime  @default(now())
  logoutAt    DateTime?
  isActive    Boolean   @default(true)
  ipAddress   String?
}

model SupportTicket {
  id           String           @id @default(uuid())
  ticketNumber String           @unique
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id])
  subject      String
  category     String           @default("GENERAL") // TECHNICAL_ISSUE, BILLING_HELP, PRINTER_SETUP, GENERAL
  status       String           @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType String        // USER, ADMIN, AI
  senderName String
  message    String
  metadata   Json?
  createdAt  DateTime      @default(now())
}

