// Production-grade Optix Backend Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  STAFF
}

enum PricingType {
  FIXED
  WEIGHT
  OPEN
}

enum OrderStatus {
  PAID
  PENDING
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

// --- CORE TABLES ---

model Business {
  id                String   @id @default(uuid())
  name              String
  email             String?
  phone             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isDeleted         Boolean  @default(false)

  // Relations
  settings          BusinessSettings?
  receiptSettings   ReceiptSettings?
  printerSettings   PrinterSettings[]
  users             User[]
  staff             Staff[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  subscriptions     Subscription[]
  paymentQrs        PaymentQr[]
  auditLogs         AuditLog[]
}

model BusinessSettings {
  id                String   @id @default(uuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id])
  currency          String   @default("INR")
  openingTime       String   @default("08:00")
  closingTime       String   @default("22:00")
  timezone          String   @default("UTC")
  taxEnabled        Boolean  @default(false)
  taxPercentage     Decimal  @default(0.0) @db.Decimal(10, 2)
}

model ReceiptSettings {
  id                String   @id @default(uuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id])
  showLogo          Boolean  @default(false)
  logoUrl           String?
  headerMessage     String?
  footerMessage     String   @default("Thank You! Visit Again 🙏")
  showBusinessName  Boolean  @default(true)
  showAddress       Boolean  @default(true)
  showPhone         Boolean  @default(true)
  qrEnabled         Boolean  @default(false)
}

model PrinterSettings {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id])
  deviceName        String?
  deviceAddress     String?
  paperWidth        Int      @default(58) // 58 or 80
  autoConnect       Boolean  @default(true)
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String   // Argon2 Hashed
  role          UserRole @default(OWNER)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])

  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Staff {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  password      String   // Argon2 Hashed
  role          UserRole @default(STAFF)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])

  // Scoped Permissions
  permissions   Permission[]

  isDisabled    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Permission {
  id          String @id @default(uuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id])
  action      String // e.g., "DELETE_BILL", "VIEW_REPORTS", "MANAGE_INVENTORY"
}

// --- SYNCABLE ENTITIES ---

model Category {
  id          String    @id @default(uuid())
  name        String
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  sortOrder   Int       @default(0)

  // Sync metadata
  version     Int       @default(1)
  isDeleted   Boolean   @default(false)
  lastModified DateTime  @updatedAt @default(now())

  products    Product[]
}

model Product {
  id           String      @id @default(uuid())
  name         String
  description  String?
  barcode      String?
  sku          String?
  price        Decimal     @db.Decimal(12, 2)
  pricingType  PricingType @default(FIXED)
  unit         String      @default("Piece")

  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id])

  isOutOfStock Boolean     @default(false)
  imageUrl     String?

  // Sync metadata
  version      Int         @default(1)
  isDeleted    Boolean     @default(false)
  lastModified DateTime    @updatedAt @default(now())

  inventory    Inventory?
  movements    StockMovement[]
}

model Inventory {
  id           String   @id @default(uuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @default(0.0) @db.Decimal(12, 3)
  minStockLevel Decimal @default(0.0) @db.Decimal(12, 3)
  lastModified DateTime @updatedAt
}

model StockMovement {
  id           String            @id @default(uuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  referenceId  String?           // e.g., OrderId
  note         String?
  createdAt    DateTime          @default(now())
}

model Order {
  id             String      @id @default(uuid())
  tokenNumber    String
  invoiceNumber  String      @unique
  status         OrderStatus @default(PAID)

  subtotal       Decimal     @db.Decimal(12, 2)
  discount       Decimal     @db.Decimal(12, 2)
  tax            Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)

  paymentMethod  PaymentMethod @default(CASH)
  cashierName    String
  customerName   String?

  businessId     String
  business       Business    @relation(fields: [businessId], references: [id])

  items          OrderItem[]
  createdAt      DateTime    @default(now())
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  productName String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int?
  weight      Decimal? @db.Decimal(12, 3)
  unit        String?
}

// --- ADMINISTRATIVE ---

model Subscription {
  id          String             @id @default(uuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id])
  planId      String
  status      SubscriptionStatus @default(TRIAL)
  expiryDate  DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PaymentQr {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  imageUrl    String
  isActive    Boolean  @default(false)
  lastModified DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  userId      String?
  action      String   // e.g. "UPDATE_PRICE", "DELETE_BILL"
  entity      String   // e.g. "PRODUCT", "ORDER"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
